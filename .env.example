# Public launch settings: leave unknown details blank.
# Set every value before building; rebuild after any change.
NOVARIS_SITE_URL=
NOVARIS_CONTACT_EMAIL=

# Explicit opt-in. A domain alone never enables search indexing.
NOVARIS_INDEXING_ENABLED=false

# Public privacy details: use only facts confirmed by the project owner.
# These values are displayed publicly; do not enter private addresses or secrets.
NOVARIS_OPERATOR_NAME=
NOVARIS_HOSTING_PROVIDER=
NOVARIS_CONTACT_PROVIDER=
NOVARIS_CONTACT_RETENTION=
NOVARIS_LOG_RETENTION=
# Calendar date, YYYY-MM-DD, of the confirmed policy update.
NOVARIS_PRIVACY_UPDATED_AT=
# Set true only after checking the displayed policy against actual services.
NOVARIS_PRIVACY_REVIEWED=false
