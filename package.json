{
  "name": "novaris",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "archive": "node scripts/validate-release.mjs",
    "validate:archive": "node scripts/validate-release.mjs",
    "validate:rendering": "node scripts/validate-release-rendering.mjs",
    "validate:learning": "node scripts/validate-learning.mjs",
    "validate:v1": "node scripts/validate-v1-pages.mjs",
